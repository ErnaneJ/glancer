<%= turbo_stream.replace "sidebar-chat-list" do %>
  <%= render "glancer/chats/sidebar_chat_list", chat: @chat, chats: @chats %>
<% end %>

<%= turbo_stream.replace "main-content" do %>
  <div id="main-content" class="flex-1 flex flex-col min-h-0">
    <%= render "glancer/chats/show",
         chat: @chat,
         chats: @chats,
         messages: [] %>
  </div>
<% end %>
