<% if chat %>
  <div class="flex-1 flex flex-col min-h-0">
    <div id="chat-messages"
         class="flex-1 overflow-y-auto px-4 py-6 space-y-6"
         role="log"
         aria-live="polite"
         aria-label="Conversation messages">
      <% if messages.blank? %>
        <div class="flex flex-col items-center justify-center h-full text-center py-12">
          <div class="w-14 h-14 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" aria-hidden="true"><use href="#icon-database"/></svg>
          </div>
          <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-1">Ready to query</h2>
          <p class="text-sm text-gray-400 dark:text-gray-500 max-w-xs">Ask anything about your database in plain language. Glancer will generate and run the SQL for you.</p>
        </div>
      <% else %>
        <% messages.each do |message| %>
          <%= render "glancer/messages/message", message: message %>
        <% end %>
      <% end %>
    </div>

    <div class="flex-shrink-0 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 px-4 py-4">
      <div class="max-w-3xl mx-auto" id="message-form">
        <%= render "glancer/messages/form", chat: chat %>
      </div>
    </div>
  </div>
<% else %>
  <div class="flex-1 flex items-center justify-center">
    <div class="text-center px-4">
      <div class="w-14 h-14 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" aria-hidden="true"><use href="#icon-database"/></svg>
      </div>
      <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-1">No chat selected</h2>
      <p class="text-sm text-gray-400 dark:text-gray-500">Create a new chat to start querying your database.</p>
    </div>
  </div>
<% end %>
