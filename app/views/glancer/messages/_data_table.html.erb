<% if data.present? && data.any? %>
  <div class="border-t border-gray-200 dark:border-gray-700">
    <div class="overflow-x-auto">
      <table class="min-w-full text-xs">
        <thead>
          <tr class="bg-gray-50 dark:bg-gray-800">
            <% data.first&.keys&.each do |key| %>
              <th class="px-3 py-2 text-left font-semibold text-gray-500 dark:text-gray-400 whitespace-nowrap border-b border-gray-200 dark:border-gray-700">
                <%= key %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          <% data.each do |row| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
              <% row.values.each do |value| %>
                <td class="px-3 py-2 text-gray-700 dark:text-gray-300 whitespace-nowrap">
                  <%= value.nil? ? '<span class="text-gray-300 dark:text-gray-600 italic">null</span>'.html_safe : value %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-between px-3 py-2 bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
      <span class="text-[11px] text-gray-400 dark:text-gray-500"><%= data.size %> <%= data.size == 1 ? 'row' : 'rows' %></span>
      <script>
        <%# Reveal the CSV download button that lives in the same controller scope %>
        (function() {
          var container = document.getElementById('results-<%= @message&.id %>');
          var scope = container?.closest('[data-controller="message"]');
          var btn = scope?.querySelector('[data-message-target="downloadBtn"]');
          if (btn) btn.classList.remove('hidden');
        })();
      </script>
    </div>
  </div>
<% else %>
  <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 text-xs text-center text-gray-400 dark:text-gray-500">
    No results returned.
  </div>
<% end %>
